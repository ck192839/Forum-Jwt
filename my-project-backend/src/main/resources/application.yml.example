spring:
  mail:
    host: smtp.163.com
    username: ${MAIL_USERNAME:your-email@163.com}
    password: ${MAIL_PASSWORD:your-password}

  rabbitmq:
    host: localhost
    username: admin
    password: ${RABBIT_PASSWORD:your-password}
    virtual-host: /
    publisher-confirm-type: correlated
    publisher-returns: true
  servlet:
    multipart:
      max-file-size: 6MB
      max-request-size: 12MB
  elasticsearch:
    uris: localhost:9200
    username: elastic
    password: ${ES_PASSWORD:your-password}
  data:
    redis:
      host: localhost
      port: 6379
      database: 0

  security:
    jwt:
      key: '${JWT_KEY:your-jwt-key}'
      expire: 72
      limit:
        base: 10
        upgrade: 300
        frequency: 30
    filter:
      order: -100

  datasource:
    driver-class-name: com.mysql.cj.jdbc.Driver
    url: jdbc:mysql://localhost:3306/test
    username: root
    password: ${DB_PASSWORD:your-password}
  flyway:
    baseline-on-migrate: true
    baseline-version: 0

  minio:
    endpoint: 'http://localhost:9000'
    username: 'minioadmin'
    password: '${MINIO_PASSWORD:your-password}'

  weather:
    api-host: 'n34y3m4qqe.re.qweatherapi.com'
    key: '${WEATHER_KEY:your-api-key}'
  ai:
    model:
      chat: deepseek
      embedding: openai
    deepseek:
      api-key: '${DEEPSEEK_API_KEY:your-deepseek-api-key}'
      base-url: '${DEEPSEEK_BASE_URL:https://api.deepseek.com}'
      chat:
        options:
          model: '${DEEPSEEK_CHAT_MODEL:deepseek-v4-flash}'
    openai:
      api-key: '${DASHSCOPE_API_KEY:your-dashscope-api-key}'
      base-url: '${DASHSCOPE_BASE_URL:your-dashscope-base-url}'
      chat:
        enabled: false
      embedding:
        options:
          model: '${DASHSCOPE_EMBEDDING_MODEL:text-embedding-v4}'
    vectorstore:
      elasticsearch:
        index-name: forum-topic-vectors
        initialize-schema: true
        dimensions: 1024
  web:
    flow:
      limit: 30
      period: 10
      block: 30
    verify:
      mail-limit: 60
    cors:
      origin: '*'
      credentials: false
      methods: '*'

# Agent 上下文治理（默认值即下述值，可不配置）
agent:
  context:
    max-context-tokens: 38000    # prompt 历史+摘要部分的 token 预算（DeepSeek 64k 窗口留余量）
    recent-window-messages: 20   # 逐字保留的最近消息条数
    summary-max-chars: 4000      # 滚动摘要最大字符数
    summarize-margin-messages: 4 # 可摘要旧消息数超过该余量才触发摘要
    summarize-timeout: 30s       # 单次摘要 LLM 调用超时
    excerpt-max-chars: 200       # search_similar_topics 返回摘要的截断长度
    read-topic-max-chars: 8000   # read_public_topic 返回正文的截断长度
    max-tool-tokens: 10000       # 单次 run 工具结果+参数累计 token 预算（执行前最坏情况预检，耗尽后引导收敛）
    max-user-message-chars: 6000 # 当前用户请求的字符上限（头尾保留截断，防超长粘贴撑爆窗口）
    summarize-threads: 2         # 摘要任务线程数（同一会话串行，不同会话并行）
